<!DOCTYPE html>
<html>
<head>
{{> head}}
<!-- Modern font -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
<style>
h1 { color: #1B4DB1; }
</style>
</head>
<body class="template-{{templateName}}">
<h1>{{name}}</h1>
<p class="contact-line">
  {{#if location}}<span>{{location}}</span>{{/if}}
  {{#if phone}}<span>{{phone}}</span>{{/if}}
  {{#if email}}<span>{{email}}</span>{{/if}}
</p>

{{#if summary}}
<h2>Summary</h2>
<p>{{summary}}</p>
{{/if}}

{{#if skills}}
<h2>Skills</h2>
<ul class="skills-list">{{#each skills}}<li>{{this}}</li>{{/each}}</ul>
{{/if}}

{{#if experience}}
<h2>Experience</h2>
<ul>
{{#each experience}}
<li><b>{{title}}</b>, {{company}}{{#with (formatTimelineRange startDate endDate) as |timeline|}}{{#if timeline}} — {{{timeline}}}{{/if}}{{/with}}
{{#if bullets}}<ul>{{#each bullets}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
</li>
{{/each}}
</ul>
{{/if}}

{{#if education}}
<h2>Education</h2>
<ul>{{#each education}}<li>{{degree}} — {{school}} {{#if graduationYear}}({{graduationYear}}){{/if}}</li>{{/each}}</ul>
{{/if}}

{{#if links}}
<h2>Links</h2>
<ul>{{#each links}}<li>{{label}} — {{url}}</li>{{/each}}</ul>
{{/if}}
</body>
</html>
